{
  "name": "faq-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "contract:generate": "cd .. && uv run python scripts/export_openapi.py && cd frontend && openapi-typescript openapi.json -o src/api-schema.ts",
    "contract:check": "npm run contract:generate && git diff --exit-code -- openapi.json src/api-schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "firebase": "^12.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.8"
  }
}
