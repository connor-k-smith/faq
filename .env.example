FAQ_ENVIRONMENT=development
FAQ_DATABASE_URL=postgresql+psycopg://faq:faq@localhost:55433/faq
FAQ_ORGANIZATION_NAME=FAQ Development
FAQ_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FAQ_SESSION_SECRET=replace-with-at-least-32-random-characters
FAQ_LOG_LEVEL=INFO
FAQ_ASSISTANT_MODEL=google-vertex:gemini-2.5-flash
FAQ_PUBLIC_BASE_URL=http://localhost:8000
FAQ_ALL_RESPONDED_GRACE_MINUTES=15
FAQ_FIREBASE_API_KEY=replace-with-firebase-web-api-key
FAQ_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FAQ_FIREBASE_PROJECT_ID=your-project-id
FAQ_FIREBASE_APP_ID=replace-with-firebase-web-app-id
# Cloud Scheduler OIDC target audience and its service-account token email.
FAQ_JOBS_AUDIENCE=https://jobs.example.com
FAQ_JOBS_CALLER_EMAIL=faq-scheduler@example-project.iam.gserviceaccount.com
# Cloud Run operator service URL and JSON allowlist of IAM user/service-account token emails.
FAQ_OPERATOR_AUDIENCE=https://operator.example.com
FAQ_OPERATOR_ALLOWED_EMAILS=["operator@example.com"]
